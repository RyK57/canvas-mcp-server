# Your institution's Canvas host — this is NOT a shared endpoint, it is the
# domain you log in to, e.g. https://bcourses.berkeley.edu or
# https://canvas.instructure.com
CANVAS_BASE_URL=https://canvas.instructure.com

# Account > Settings > New Access Token, in your Canvas web UI
CANVAS_ACCESS_TOKEN=0000~xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# CANVAS_REQUEST_TIMEOUT_MS=30000
